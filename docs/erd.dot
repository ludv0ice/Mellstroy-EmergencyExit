digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.35", ranksep="1"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9];
distances [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>distances</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">kilometers: NUMERIC(5, 2)</TD></TR></TABLE>>];
marathons [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>marathons</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">year: INTEGER</TD></TR><TR><TD ALIGN="LEFT">city: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">country_code: VARCHAR(2)</TD></TR><TR><TD ALIGN="LEFT">event_date: DATE</TD></TR></TABLE>>];
roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">code: VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(100)</TD></TR></TABLE>>];
sponsors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>sponsors</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">email: VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT">phone: VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">description: TEXT</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">email: VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT">password_hash: VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">is_active: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME</TD></TR></TABLE>>];
volunteers [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>volunteers</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">first_name: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">last_name: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">email: VARCHAR(254)</TD></TR><TR><TD ALIGN="LEFT">phone: VARCHAR(30)</TD></TR></TABLE>>];
news [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>news</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">marathon_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">author_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">language_code: VARCHAR(5)</TD></TR><TR><TD ALIGN="LEFT">title: VARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">body: TEXT</TD></TR><TR><TD ALIGN="LEFT">published_at: DATETIME</TD></TR></TABLE>>];
users -> news [label="author_id"];
marathons -> news [label="marathon_id"];
races [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>races</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">marathon_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">distance_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">starts_at: DATETIME</TD></TR><TR><TD ALIGN="LEFT">capacity: INTEGER</TD></TR></TABLE>>];
marathons -> races [label="marathon_id"];
distances -> races [label="distance_id"];
runners [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>runners</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">user_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">first_name: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">last_name: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">birth_date: DATE</TD></TR><TR><TD ALIGN="LEFT">country_code: VARCHAR(2)</TD></TR></TABLE>>];
users -> runners [label="user_id"];
user_roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>user_roles</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">user_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">role_id: INTEGER FK</TD></TR></TABLE>>];
users -> user_roles [label="user_id"];
roles -> user_roles [label="role_id"];
volunteer_assignments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>volunteer_assignments</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">volunteer_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">marathon_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">duty: VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">starts_at: DATETIME</TD></TR><TR><TD ALIGN="LEFT">ends_at: DATETIME</TD></TR></TABLE>>];
marathons -> volunteer_assignments [label="marathon_id"];
volunteers -> volunteer_assignments [label="volunteer_id"];
achievements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>achievements</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">runner_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">title: VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">description: TEXT</TD></TR><TR><TD ALIGN="LEFT">achieved_on: DATE</TD></TR></TABLE>>];
runners -> achievements [label="runner_id"];
registrations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>registrations</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">runner_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">race_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">bib_number: INTEGER</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">registered_at: DATETIME</TD></TR></TABLE>>];
races -> registrations [label="race_id"];
runners -> registrations [label="runner_id"];
certificates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>certificates</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">registration_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">number: VARCHAR(60)</TD></TR><TR><TD ALIGN="LEFT">kind: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">issued_at: DATETIME</TD></TR><TR><TD ALIGN="LEFT">file_path: VARCHAR(500)</TD></TR></TABLE>>];
registrations -> certificates [label="registration_id"];
results [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>results</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">registration_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(10)</TD></TR><TR><TD ALIGN="LEFT">elapsed_seconds: INTEGER</TD></TR></TABLE>>];
registrations -> results [label="registration_id"];
sponsorships [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#dce9f7"><B>sponsorships</B></TD></TR><TR><TD ALIGN="LEFT">id: INTEGER PK</TD></TR><TR><TD ALIGN="LEFT">sponsor_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">registration_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">amount: NUMERIC(12, 2)</TD></TR><TR><TD ALIGN="LEFT">currency: VARCHAR(3)</TD></TR><TR><TD ALIGN="LEFT">terms: TEXT</TD></TR><TR><TD ALIGN="LEFT">document_path: VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">confirmed_by_id: INTEGER FK</TD></TR><TR><TD ALIGN="LEFT">confirmed_at: DATETIME</TD></TR></TABLE>>];
sponsors -> sponsorships [label="sponsor_id"];
users -> sponsorships [label="confirmed_by_id"];
registrations -> sponsorships [label="registration_id"];
}